# Optional. Enables AI slide copy (generate_slide_copy.mjs) and per-image vision
# analysis (analyze_image.mjs). Generate with:  claude setup-token
# Without it, both features degrade to [MOCK] copy / neutral signals — never a failure.
CLAUDE_CODE_OAUTH_TOKEN=

# Do NOT set ANTHROPIC_API_KEY here or in your shell. Both .mjs bridges reject it
# (exit 2) to keep usage on Claude Code subscription billing, never metered API billing.

# Which brand theme.py activates: resolves to brands/<name>.json (gitignored per-installation
# config — copy brands/_example.json.template to start one). Leave unset/blank to render the
# neutral built-in placeholder brand. To point at a brand file outside brands/ instead, set
# BRAND_CONFIG to its path (absolute or repo-relative) — it wins over ACTIVE_BRAND.
ACTIVE_BRAND=citiview
