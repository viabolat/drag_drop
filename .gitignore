# Per-installation brand config — never commit (client colors/logo/contact details).
# theme.py loads brands/<name>.json via ACTIVE_BRAND (or any path via BRAND_CONFIG).
# The schema template is tracked so a new install has something to copy from.
brands/*.json
!brands/_example.json.template

# Secrets and sensitive data — never commit
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*credentials*.json
*secret*
secrets/

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/

# Generated render artifacts and outputs
outputs/
temp_uploads/
__ui_slide_*.jpg
*.mp4
*.pdf

# Scratch / trash
trash/

# OS / logs
.DS_Store
Thumbs.db
*.log
